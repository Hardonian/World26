{
  "name": "world26-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WORLD//26 - An Open Planetary Systems Simulator",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:sim": "cargo test --all && pnpm --filter @world26/model test",
    "test:e2e": "pnpm --filter @world26/web test:e2e",
    "data:validate": "pnpm --filter @world26/data validate",
    "data:provenance": "pnpm --filter @world26/data provenance",
    "data:checksum": "pnpm --filter @world26/data checksum",
    "data:sync": "node ./tools/data-sync/sync-all.js",
    "model:validate": "pnpm --filter @world26/model validate",
    "benchmark": "node ./tools/benchmarks/benchmark.js",
    "calibrate": "node ./tools/calibration/calibrate.js",
    "reproduce": "node ./tools/reproduce.js",
    "cargo:fmt": "cargo fmt --check",
    "cargo:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "cargo:test": "cargo test --all"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
